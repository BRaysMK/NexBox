{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NexBox",
  "version": "8.0.9+08162145",
  "identifier": "NexBox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NexBox",
        "width": 1230,
        "height": 771,
        "minWidth": 1140,
        "minHeight": 715,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "resources": [
      "../nvidiaProfileInspector.exe",
      "../nvidiaProfileInspector.exe.config",
      "../Reference.xml",
      "../power-plans/*",
      "../monitor/bin/Release/net48/*",
      "../aq_registry/*",
      "../aq_registry_restore/*",
      "resources/binaries/fxvad/*",
      "resources/binaries/fxvad/presets/*",
      "resources/binaries/PresentMon-2.5.1-x64.exe",
      "resources/binaries/icc-tools/*",
      "resources/binaries/PawnIO_setup.exe",
      "resources/crosshair-presets/*",
      "resources/icc-presets/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
